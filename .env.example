# Leave the WorkOS values empty to run in local dev mode (X-User-Id header, SQLite audit only).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Needed only to send decisions to WorkOS Audit Logs
WORKOS_ORGANIZATION_ID=

SESSION_SECRET=change-me
# Leave empty to use agentguard.db in the project folder
AGENTGUARD_DB=
DASHBOARD_URL=/me

# Used by the MCP server
AGENTGUARD_URL=http://127.0.0.1:8000
AGENTGUARD_AGENT_ID=support-bot
AGENTGUARD_COST_PER_CALL_INR=2
